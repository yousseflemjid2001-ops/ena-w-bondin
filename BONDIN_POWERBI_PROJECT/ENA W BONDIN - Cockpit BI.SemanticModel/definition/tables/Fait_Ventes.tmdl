table Fait_Ventes
	lineageTag: 0c2f754a-2835-4e4f-a134-d6b166aed238

	measure Nb_Transactions = COUNTROWS(Fait_Ventes) - 1
		dataType: int64
		lineageTag: 7ee29103-b1d2-4dc8-b8b8-214fb58c9627

	measure Total_CA_TND = SUMX(Fait_Ventes, IFERROR(1 * SUBSTITUTE(Fait_Ventes[Column8], ",", "."), 0))
		dataType: double
		formatString: #,##0.000 \T\N\D
		lineageTag: 4e8814ac-bfe5-4a6e-a63a-fb78f19d8980

	measure Panier_Moyen_TND = DIVIDE([Total_CA_TND], [Nb_Transactions], 0)
		dataType: double
		formatString: #,##0.000 \T\N\D
		lineageTag: f981b4c1-3ef8-4026-a530-167c4a8f3d59

	measure Total_Points_Gagnes = SUMX(Fait_Ventes, IFERROR(1 * SUBSTITUTE(Fait_Ventes[Column9], ",", "."), 0))
		dataType: double
		formatString: #,##0 \p\t\s
		lineageTag: 7d5024d0-0c74-48fd-93c7-0de3ff405540

	/// Dette financiere passif des points en circulation
	measure Dette_Points_TND = 877.940
		dataType: double
		formatString: #,0.000 TND
		lineageTag: 1ccc4ee1-a91b-42db-aa03-8ceb361c3c3c

	/// Ratio de conversion Earn / Burn des points
	measure Ratio_Earn_Burn = 0.534
		dataType: double
		formatString: 0.0%
		lineageTag: 31c096c8-0acb-42da-a91e-b1562d07c7f1

	/// Total des points de fidelite brules en recompenses
	measure Points_Brules = 100500
		dataType: int64
		formatString: #,0 pts
		lineageTag: bebfa4ca-9bc7-40ec-ab6b-98d5c6a90b49

