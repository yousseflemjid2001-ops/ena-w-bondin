model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: fr-FR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Dim_Client","Dim_Magasin","Dim_Recompense","Fait_Mouvements","Fait_Ventes","Fait_Parrainages"]

annotation __PBI_TimeIntelligenceEnabled = 1

ref table Dim_Client
ref table Dim_Magasin
ref table Dim_Recompense
ref table Fait_Mouvements
ref table Fait_Ventes
ref table Fait_Parrainages

