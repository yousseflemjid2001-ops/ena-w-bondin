  "rewrites": [
    { "source": "/api/rag/chat", "destination": "/api/chat" },
    { "source": "/api/simulate-scan", "destination": "/api/simulate_scan" },
    { "source": "/api/campaign/push", "destination": "/api/campaign/push" }
  ],
  "functions": {
