{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/live", "destination": "/api/live.py" },
    { "source": "/api/cron/sync", "destination": "/api/sync.py" },
    { "source": "/api/sync", "destination": "/api/sync.py" },
    { "source": "/api/rag/chat", "destination": "/api/chat.py" },
    { "source": "/api/chat", "destination": "/api/chat.py" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/", "destination": "/dashboard_bi/index.html" },
    { "source": "/(.*)", "destination": "/dashboard_bi/$1" }
  ]
}
